# Gateway 환경변수 (접두사: GW_)

GW_HOST=0.0.0.0
GW_PORT=17801

# vLLM 서버 URL (intent / answer 분리)
# 단일 서버면 같은 URL, 2서버면 각각 다른 URL 지정
GW_INTENT_VLLM_URL=http://localhost:8000
GW_ANSWER_VLLM_URL=http://localhost:8000

# vllm_serving 관리 서버 URL (서빙 시작/중지/상태 프록시용, 미설정 시 admin API 비활성)
GW_INTENT_SERVING_URL=http://127.0.0.1:6300
GW_ANSWER_SERVING_URL=http://127.0.0.1:6300

# 모델 이름 (vLLM에 등록된 이름)
GW_INTENT_MODEL_NAME=intent
GW_ANSWER_MODEL_NAME=answer

# 추론 파라미터
GW_INTENT_MAX_TOKENS=128
GW_INTENT_TEMPERATURE=0.0
GW_ANSWER_MAX_TOKENS=512
GW_ANSWER_TEMPERATURE=0.3



GW_HTTP_TIMEOUT=60.0
GW_LOG_LEVEL=INFO
