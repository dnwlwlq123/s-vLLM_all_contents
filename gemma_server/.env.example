# Gemma4 Gateway 환경변수 (접두사: GW_)
# 사용법: cp .env.example .env 후 필요한 값만 수정

# === 서버 ===
GW_HOST=0.0.0.0
GW_PORT=17801
GW_LOG_LEVEL=INFO

# === vLLM 연결 (호스트에서 start_vllm.sh 로 기동한 vLLM) ===
# 단일 서버면 같은 URL, 2서버면 각각 다른 URL 지정
GW_INTENT_VLLM_URL=http://localhost:8000
GW_ANSWER_VLLM_URL=http://localhost:8000

# === vllm_serving 관리 서버 (선택, 미사용 시 빈 값) ===
GW_INTENT_SERVING_URL=
GW_ANSWER_SERVING_URL=

# === 모델 이름 (vLLM --served-model-name 과 일치해야 함) ===
GW_BASE_MODEL_NAME=gemma-4-31B-it
GW_INTENT_MODEL_NAME=intent
GW_ANSWER_MODEL_NAME=answer

# === intent 추론 ===
GW_INTENT_MAX_TOKENS=128
GW_INTENT_TEMPERATURE=0.0

# === answer 추론 ===
GW_ANSWER_MAX_TOKENS=1024
GW_ANSWER_TEMPERATURE=0.3

# === 공통 ===
GW_DEFAULT_TOP_P=0.9
GW_HTTP_TIMEOUT=60.0
