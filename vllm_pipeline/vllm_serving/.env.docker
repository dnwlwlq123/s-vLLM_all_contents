# vllm_serving Docker 환경변수

VS_HOST=0.0.0.0
VS_PORT=17810

# S3/MinIO
VS_S3_ENDPOINT_URL=http://minio:9000
VS_S3_ACCESS_KEY=minioadmin
VS_S3_SECRET_KEY=minioadmin
VS_S3_BUCKET=sllm-models
VS_S3_REGION=us-east-1

# Docker 볼륨 마운트 경로
VS_MODEL_CACHE_DIR=/app/models

# vLLM 프로세스
VS_VLLM_HOST=0.0.0.0
VS_VLLM_PORT=8000
VS_VLLM_GPU_MEMORY_UTILIZATION=0.85
VS_VLLM_MAX_MODEL_LEN=4096
VS_VLLM_MAX_LORA_RANK=32
VS_VLLM_SWAP_SPACE=4
VS_VLLM_MAX_NUM_SEQS=16
VS_VLLM_STARTUP_TIMEOUT=300

VS_LOG_LEVEL=INFO
